# Hotel API Environment Variables
# Copy this file to .env and fill in the values

# Node environment
NODE_ENV=development

# Server port
PORT=3000

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Database Configuration
DB_URL=mongodb://mongodb:27017/hotel_db

# External API Configuration
EXTERNAL_API=http://localhost:5000/hotels/

# Redis Configuration (for caching)
REDIS_HOST=redis
REDIS_PORT=6379
